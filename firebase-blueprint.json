{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and permissions",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "username": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 100 },
        "loginProvider": { "type": "string", "enum": ["google", "password"] },
        "roles": { "type": "array" },
        "department": { "type": "string", "maxLength": 100 },
        "program": { "type": "string", "maxLength": 100 },
        "semester": { "type": "string", "maxLength": 50 },
        "studentId": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "name", "username", "loginProvider", "roles", "createdAt"]
    },
    "UsernameMapping": {
      "title": "UsernameMapping",
      "description": "Unique username registry",
      "type": "object",
      "properties": {
        "username": { "type": "string", "maxLength": 30 },
        "uid": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["username", "uid"]
    },
    "Notice": {
      "title": "Notice",
      "description": "Official announcements and campus notices",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 2000 },
        "category": { "type": "string", "maxLength": 50 },
        "priority": { "type": "string", "enum": ["High", "Medium", "Normal"] },
        "authorName": { "type": "string", "maxLength": 100 },
        "authorUid": { "type": "string" },
        "authorRole": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "description", "category", "priority", "authorName", "authorUid", "createdAt"]
    },
    "TimetableClass": {
      "title": "TimetableClass",
      "description": "Weekly course timetable item",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "subject": { "type": "string", "maxLength": 100 },
        "day": { "type": "string", "maxLength": 20 },
        "startTime": { "type": "string", "maxLength": 20 },
        "endTime": { "type": "string", "maxLength": 20 },
        "instructor": { "type": "string", "maxLength": 100 },
        "room": { "type": "string", "maxLength": 50 },
        "updatedBy": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["subject", "day", "startTime", "endTime", "instructor", "room"]
    },
    "Material": {
      "title": "Material",
      "description": "Academic resources and lecture notes",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "subject": { "type": "string", "maxLength": 100 },
        "description": { "type": "string", "maxLength": 1000 },
        "fileName": { "type": "string", "maxLength": 150 },
        "fileSize": { "type": "string", "maxLength": 50 },
        "fileType": { "type": "string", "maxLength": 50 },
        "uploaderName": { "type": "string", "maxLength": 100 },
        "uploaderUid": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["title", "subject", "fileName", "uploaderName", "uploaderUid", "createdAt"]
    },
    "SubjectGroup": {
      "title": "SubjectGroup",
      "description": "Subject or class chat group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 30 },
        "description": { "type": "string", "maxLength": 500 },
        "createdBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "code", "createdBy", "createdAt"]
    },
    "GroupMessage": {
      "title": "GroupMessage",
      "description": "Chat message within a subject group",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderRole": { "type": "string", "maxLength": 50 },
        "text": { "type": "string", "maxLength": 2000 },
        "createdAt": { "type": "string" }
      },
      "required": ["groupId", "senderUid", "senderName", "text", "createdAt"]
    },
    "LostFoundItem": {
      "title": "LostFoundItem",
      "description": "Lost or found item listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["lost", "found"] },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 1000 },
        "location": { "type": "string", "maxLength": 100 },
        "posterName": { "type": "string", "maxLength": 100 },
        "posterUid": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "claimed", "resolved"] },
        "date": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["type", "title", "description", "location", "posterName", "posterUid", "status", "createdAt"]
    },
    "MarketplaceListing": {
      "title": "MarketplaceListing",
      "description": "Campus marketplace goods and exchange listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string", "maxLength": 150 },
        "description": { "type": "string", "maxLength": 2000 },
        "price": { "type": "number" },
        "category": { "type": "string", "maxLength": 50 },
        "condition": { "type": "string", "maxLength": 50 },
        "listingType": { "type": "string", "enum": ["for_sale", "wanted", "free"] },
        "campus": { "type": "string", "maxLength": 100 },
        "sellerUid": { "type": "string" },
        "sellerName": { "type": "string", "maxLength": 100 },
        "sellerDepartment": { "type": "string", "maxLength": 100 },
        "sellerProgram": { "type": "string", "maxLength": 100 },
        "status": { "type": "string", "enum": ["active", "reserved", "sold", "expired"] },
        "imageUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["title", "price", "category", "sellerUid", "sellerName", "status", "createdAt"]
    },
    "MarketplaceMessage": {
      "title": "MarketplaceMessage",
      "description": "Direct message on a marketplace listing",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "listingId": { "type": "string" },
        "senderUid": { "type": "string" },
        "senderName": { "type": "string", "maxLength": 100 },
        "recipientUid": { "type": "string" },
        "text": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["listingId", "senderUid", "recipientUid", "text", "createdAt"]
    },
    "AcademicDepartment": {
      "title": "AcademicDepartment",
      "description": "University academic department",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 30 },
        "faculty": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "code"]
    },
    "AcademicProgram": {
      "title": "AcademicProgram",
      "description": "Degree program offered by university",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string", "maxLength": 100 },
        "code": { "type": "string", "maxLength": 30 },
        "departmentId": { "type": "string" },
        "degreeType": { "type": "string", "maxLength": 30 },
        "totalSemesters": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["name", "code", "departmentId"]
    },
    "TimetablePdfUpload": {
      "title": "TimetablePdfUpload",
      "description": "Master PDF upload metadata and parsing status",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "fileName": { "type": "string", "maxLength": 200 },
        "term": { "type": "string", "maxLength": 50 },
        "academicYear": { "type": "string", "maxLength": 50 },
        "status": { "type": "string", "enum": ["uploaded", "parsed", "reviewed", "published"] },
        "entriesCount": { "type": "number" },
        "uploadedBy": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["fileName", "term", "status", "uploadedBy", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Administrative actions audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "actorUid": { "type": "string" },
        "actorName": { "type": "string", "maxLength": 100 },
        "actorEmail": { "type": "string", "maxLength": 100 },
        "action": { "type": "string", "maxLength": 100 },
        "target": { "type": "string", "maxLength": 100 },
        "details": { "type": "string", "maxLength": 1000 },
        "createdAt": { "type": "string" }
      },
      "required": ["actorUid", "actorName", "action", "target", "createdAt"]
    },
    "Notification": {
      "title": "Notification",
      "description": "User notification",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "recipientUid": { "type": "string" },
        "title": { "type": "string", "maxLength": 100 },
        "message": { "type": "string", "maxLength": 300 },
        "type": { "type": "string", "maxLength": 50 },
        "link": { "type": "string", "maxLength": 100 },
        "isRead": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["recipientUid", "title", "message", "isRead", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles and assigned roles"
    },
    "/usernames/{username}": {
      "schema": "UsernameMapping",
      "description": "Unique username mappings to user IDs"
    },
    "/notices/{noticeId}": {
      "schema": "Notice",
      "description": "University notices and announcements"
    },
    "/timetable/{classId}": {
      "schema": "TimetableClass",
      "description": "Weekly course timetable records"
    },
    "/materials/{materialId}": {
      "schema": "Material",
      "description": "Uploaded academic materials metadata"
    },
    "/groups/{groupId}": {
      "schema": "SubjectGroup",
      "description": "Subject study and discussion groups"
    },
    "/groups/{groupId}/messages/{messageId}": {
      "schema": "GroupMessage",
      "description": "Real-time messages within subject groups"
    },
    "/lost_found/{itemId}": {
      "schema": "LostFoundItem",
      "description": "Lost and found item postings"
    },
    "/marketplace/{listingId}": {
      "schema": "MarketplaceListing",
      "description": "Campus marketplace listings"
    },
    "/marketplace/{listingId}/messages/{messageId}": {
      "schema": "MarketplaceMessage",
      "description": "Messages between buyer and seller"
    },
    "/academic_departments/{deptId}": {
      "schema": "AcademicDepartment",
      "description": "Configured academic departments"
    },
    "/academic_programs/{programId}": {
      "schema": "AcademicProgram",
      "description": "Configured academic degree programs"
    },
    "/timetable_pdfs/{pdfId}": {
      "schema": "TimetablePdfUpload",
      "description": "Uploaded timetable master PDFs and versions"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "System and administrative action audit trail"
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "User notifications"
    }
  }
}
