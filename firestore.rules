rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function userDoc(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isOwner(){ return signedIn() && request.auth.token.email == 'sanaullahmawia980@gmail.com' && request.auth.token.firebase.sign_in_provider == 'google.com'; }
    function has(role){ return signedIn() && (role in userDoc().roles || isOwner()); }

    match /usernames/{username} {
      allow get: if true; // exact lookup is required for username/password sign-in
      allow list: if false;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.username == username;
      allow update, delete: if false;
    }
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow get: if signedIn();
      allow list: if isOwner();
      allow update: if isOwner() || (signedIn() && request.auth.uid == uid && request.resource.data.roles == resource.data.roles && request.resource.data.uid == resource.data.uid);
      allow delete: if isOwner();
    }
    match /notices/{id} { allow read: if signedIn(); allow create: if has('announcement_publisher') || has('institution_admin'); allow update,delete: if isOwner() || resource.data.authorUid == request.auth.uid; }
    match /groups/{gid} { allow read: if signedIn(); allow create,update,delete: if has('institution_admin'); match /messages/{mid} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow update,delete: if isOwner() || resource.data.uid == request.auth.uid; } }
    match /roleAudit/{id} { allow read,create: if isOwner(); }
    match /{document=**} { allow read,write: if false; }
  }
}
