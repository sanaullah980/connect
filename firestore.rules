rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // Main Owner: based directly on the authenticated Firebase account.
    function isOwner() {
      return signedIn()
        && request.auth.token.email != null
        && request.auth.token.email == 'sanaullahmawia980@gmail.com';
    }

    function userExists() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function myUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return isOwner() || (userExists() && role in myUser().roles);
    }

    function isAdmin() {
      return hasRole('institution_admin');
    }

    function canPublishNotices() {
      return isOwner()
        || hasRole('institution_admin')
        || hasRole('announcement_publisher');
    }

    function canManageTimetable() {
      return isOwner()
        || hasRole('institution_admin')
        || hasRole('timetable_manager');
    }

    function canModerate() {
      return isOwner()
        || hasRole('institution_admin')
        || hasRole('moderator');
    }

    // Unique username index
    match /usernames/{username} {
      allow get: if true;
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username == username;
      allow update, delete: if false;
    }

    // User profiles and role storage
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow get: if signedIn();
      allow list: if isOwner() || isAdmin();

      // Owner/admin can manage roles. A user may edit their own profile but never roles.
      allow update: if isOwner()
        || isAdmin()
        || (signedIn()
          && request.auth.uid == uid
          && request.resource.data.roles == resource.data.roles
          && request.resource.data.uid == resource.data.uid);

      allow delete: if isOwner();
    }

    // Shared official notices used by js/notices.js and js/firebase.js
    match /notices/{noticeId} {
      allow read: if signedIn();

      allow create: if canPublishNotices()
        && request.resource.data.authorUid == request.auth.uid;

      allow update: if isOwner()
        || isAdmin()
        || (signedIn() && resource.data.authorUid == request.auth.uid);

      allow delete: if isOwner()
        || isAdmin()
        || (signedIn() && resource.data.authorUid == request.auth.uid);
    }

    // Timetable documents
    match /timetables/{id} {
      allow read: if signedIn();
      allow create, update: if canManageTimetable();
      allow delete: if isOwner() || isAdmin();
    }

    // Materials
    match /materials/{id} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isOwner() || isAdmin()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Groups and real-time messages
    match /groups/{groupId} {
      allow read: if signedIn();
      allow create: if signedIn();
      allow update, delete: if isOwner() || isAdmin();

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn()
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if isOwner()
          || canModerate()
          || (signedIn() && resource.data.uid == request.auth.uid);
      }
    }

    // Lost and Found
    match /lostFound/{id} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if canModerate()
        || (signedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Per-user notifications
    match /notifications/{id} {
      allow read, update, delete: if signedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if signedIn();
    }

    // Role audit written by owner/admin actions
    match /roleAudit/{id} {
      allow read: if isOwner() || isAdmin();
      allow create: if isOwner() || isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
