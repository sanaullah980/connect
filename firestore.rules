rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwnerEmail() {
      return isSignedIn() && request.auth.token.email == "sanaullahmawia980@gmail.com";
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasAnyRole(rolesList) {
      return isOwnerEmail() || (
        isSignedIn() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getUserData().roles.hasAny(rolesList)
      );
    }

    function isStaffOrAdmin() {
      return isOwnerEmail() || hasAnyRole(['Institution Admin', 'Moderator', 'Teacher']);
    }

    // Connection test document (for getFromServer validation)
    match /test/{docId} {
      allow read, write: if isSignedIn();
    }

    // Username mapping
    match /usernames/{username} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isOwnerEmail();
    }

    // User profiles
    match /users/{userId} {
      // Any signed in user can read user profiles
      allow read: if isSignedIn();
      
      // Creating initial profile upon signup
      allow create: if isSignedIn() && request.auth.uid == userId && (
        isOwnerEmail() || 
        (request.resource.data.roles.hasOnly(['Student']) || request.resource.data.roles.size() == 0)
      );
      
      // Update profile:
      // Owner can update roles and info
      // Regular user can only update their own non-role profile fields (name, department, semester, etc.)
      allow update: if isSignedIn() && (
        isOwnerEmail() || (
          request.auth.uid == userId && 
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['roles', 'email', 'loginProvider', 'uid'])
        )
      );

      // Deletion: Only owner, but owner account can NEVER be deleted
      allow delete: if isOwnerEmail() && resource.data.email != "sanaullahmawia980@gmail.com";
    }

    // Notices & Announcements
    match /notices/{noticeId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (
        isOwnerEmail() || 
        hasAnyRole(['Institution Admin', 'Announcement Publisher', 'Teacher', 'CR'])
      ) && request.resource.data.authorUid == request.auth.uid;
      
      allow update, delete: if isSignedIn() && (
        isOwnerEmail() || 
        resource.data.authorUid == request.auth.uid ||
        hasAnyRole(['Institution Admin'])
      );
    }

    // Timetable
    match /timetable/{classId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isSignedIn() && (
        isOwnerEmail() || 
        hasAnyRole(['Institution Admin', 'Timetable Manager'])
      );
    }

    // Academic Materials
    match /materials/{materialId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.uploaderUid == request.auth.uid;
      allow update, delete: if isSignedIn() && (
        isOwnerEmail() || 
        resource.data.uploaderUid == request.auth.uid ||
        hasAnyRole(['Institution Admin', 'Moderator'])
      );
    }

    // Subject Groups
    match /groups/{groupId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && (
        isOwnerEmail() || 
        resource.data.createdBy == request.auth.uid ||
        hasAnyRole(['Institution Admin'])
      );

      // Group Chat Messages
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderUid == request.auth.uid;
        allow update, delete: if isSignedIn() && (
          isOwnerEmail() || 
          resource.data.senderUid == request.auth.uid ||
          hasAnyRole(['Institution Admin', 'Moderator'])
        );
      }
    }

    // Lost and Found
    match /lost_found/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.posterUid == request.auth.uid;
      allow update: if isSignedIn() && (
        isOwnerEmail() || 
        resource.data.posterUid == request.auth.uid ||
        hasAnyRole(['Institution Admin', 'Moderator'])
      );
      allow delete: if isSignedIn() && (
        isOwnerEmail() || 
        resource.data.posterUid == request.auth.uid ||
        hasAnyRole(['Institution Admin', 'Moderator'])
      );
    }

    // Notifications
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn() && resource.data.recipientUid == request.auth.uid;
    }
  }
}
