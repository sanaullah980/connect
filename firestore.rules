rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function me(){ return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function admin(){ return signedIn() && 'institution_admin' in me().roles; }
    function canPublish(){ return signedIn() && (admin() || 'announcement_publisher' in me().roles); }
    match /users/{uid} {
      allow create: if signedIn() && request.auth.uid == uid;
      allow read: if signedIn();
      allow update: if signedIn() && request.auth.uid == uid && request.resource.data.roles == resource.data.roles;
      allow update, delete: if admin();
    }
    match /notices/{id} { allow read: if signedIn(); allow create: if canPublish(); allow update, delete: if admin() || (canPublish() && resource.data.authorUid == request.auth.uid); }
    match /groups/{gid} { allow read: if signedIn(); allow create, update, delete: if admin(); match /messages/{mid} { allow read: if signedIn(); allow create: if signedIn() && request.resource.data.uid == request.auth.uid; allow update, delete: if admin() || resource.data.uid == request.auth.uid; } }
    match /roleAudit/{id} { allow read: if admin(); allow create: if admin(); }
    match /{document=**} { allow read, write: if false; }
  }
}
